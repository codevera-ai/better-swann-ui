# Copy this file to .env and fill it in.
#   cp .env.example .env
# .env is never committed. Nothing here leaves your own machine.

# Your recorder's address on your home network. Find it in the recorder's
# own menu, under Network, or in your router's device list.
SWANN_HOST=192.168.1.100

# The login you use on the recorder itself.
SWANN_USER=admin
SWANN_PASS=

# Ports. These are the Swann and Xiongmai defaults. Only change them if you
# moved them in the recorder's own Network settings.
SWANN_WEB_PORT=85
SWANN_RTSP_PORT=554
SWANN_DVRIP_PORT=9000

# How many camera sockets your recorder has. Only a fallback: the app asks
# the recorder and uses its answer when it gets one.
SWANN_CHANNELS=8

# Where the app listens on your own machine. Leave these alone unless the
# port is already taken.
SWANN_APP_HOST=127.0.0.1
SWANN_APP_PORT=8750

# Only set these if ffmpeg is not on your PATH.
# SWANN_FFMPEG=/opt/homebrew/bin/ffmpeg
# SWANN_FFPROBE=/opt/homebrew/bin/ffprobe
